# Copy to .env.local for local overrides. Never commit real values.
# The event itself (name, time zone, dates, repo, base path) lives in hub.config.json, not here.

# Secret for the unlock link: share <board address>/unlock?key=<HUB_KEY> with the team.
# Required in production (without it every page returns 404). Unset in development means open.
HUB_KEY=

# The default is ONE fine-grained token, limited to this hub repo, with Contents: read and write,
# set as both HUB_READ_TOKEN and HUB_WRITE_TOKEN (./hub setup --tokens does this). The board
# reads the repo with HUB_READ_TOKEN and saves events with HUB_WRITE_TOKEN. For least privilege,
# ./hub setup --separate-tokens sets a Contents: read-only token as HUB_READ_TOKEN instead.
# Replacing the token by hand: update both.
HUB_READ_TOKEN=
HUB_WRITE_TOKEN=

# Optional: owner/name of this hub repo. Without it the board uses hub.repo from
# hub.config.json, then the repo Vercel built the deployment from.
HUB_REPO=

# Optional: read and write a hub checkout on disk instead of GitHub (any environment).
# Defaults to the current directory in development. Try tests/fixtures/demo-hub.
HUB_LOCAL_DIR=
